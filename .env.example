# The three settings Dennis needs to reach its database.
#
# Copy this file to .env.local for running on your own machine. .env.local is
# never committed - see .gitignore - which is the point: the third one below
# is a skeleton key.
#
# On Vercel these go in Project Settings -> Environment Variables instead.

# Your Supabase project's URL. Supabase dashboard -> Project Settings -> API.
# Safe to be public: it is just an address, and the browser needs it.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# The anon / publishable key, from the same page.
# Also safe to be public. Row level security is on for every table with no
# policy granted, so this key can read and write precisely nothing. All it is
# used for is signing in and carrying the session.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The service role key, from the same page, under "Project API keys".
#
# This one is different in kind. It goes straight through row level security
# and can read, change or delete anything in the project. It must never be
# committed, never sent to a browser, and never given the NEXT_PUBLIC_ prefix -
# that prefix is what tells Next to bundle a value into the JavaScript it
# serves, which would put this key in the hands of anyone who opened the page.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
